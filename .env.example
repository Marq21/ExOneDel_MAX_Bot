# Токен бота, полученный при регистрации в MAX
BOT_TOKEN="max_token_here"

# Ваш домен, на который будут приходить вебхуки
WEBHOOK_DOMAIN="webhook_here"

# Секрет для проверки вебхуков (можно сгенерировать любой сложный пароль)
WEBHOOK_SECRET="web_hook_secret"

# Режим разработки или продакшн
ENVIRONMENT="dev"