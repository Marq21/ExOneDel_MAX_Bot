{$WEBHOOK_DOMAIN} {
    # Современный формат логов
    log {
        output stdout
        format console
    }

    # Явный ответ для health-check
    respond /health "OK" 200

    # Проксирование с активной проверкой здоровья
    reverse_proxy /max/webhook/* max-bot:8080 {
        health_uri /health
        health_interval 10s
    }

    # Блокировка всех остальных запросов
    abort
}